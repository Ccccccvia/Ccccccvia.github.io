{
  "name": "knowledgeos-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:content && astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "test:content": "node --test tests/content.test.mjs tests/paths.test.mjs",
    "test:examples": "node scripts/check-examples.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "test": "npm run test:content && npm run test:examples && npm run build && npm run test:ui"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.2",
    "typescript": "6.0.3"
  }
}
