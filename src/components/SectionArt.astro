        </g>
      </svg>
      <svg class="sky-cloud-left" viewBox="-115 -40 510 300" fill="none" focusable="false">
        <g class="scene-front"><g class="cloud-drift">
          <path d="M-100 47h98c10-44 57-65 93-38 23-22 66-19 85 13 43-5 77 24 76 62h19c37 0 59 27 59 59 32 0 55 23 55 51 0 29-23 48-58 48H-100Z" fill={paint('cloud-shadow')} />
          <path d="M-100 17H-4C8-20 57-33 88-7c31-20 70-3 80 28h14c37 0 61 25 61 62h22c30 0 52 24 52 52h14c27 0 46 19 46 44s-21 41-51 41H-100Z" fill={paint('cloud')} />
          <path d="M-40 166h188c25 0 41-15 41-36v-9h49M-10 200h271c19 0 33-9 39-21" stroke="#fff" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" />
          <path d="M-60 82H58c27 0 44 17 44 39H-60Z" fill="#fff" opacity=".65" />
        </g></g>
      </svg>
      <svg class="sky-cloud-right" viewBox="1115 85 425 245" fill="none" focusable="false">
        <g class="scene-front"><g class="cloud-drift cloud-drift--reverse">
          <path d="M1510 155h-91c-11-40-62-55-91-26-30-16-62 2-67 33h-13c-34 0-54 22-54 51-36 0-55 23-55 49 0 30 22 47 56 47h315Z" fill={paint('cloud-shadow')} />
          <path d="M1510 129h-90c-14-38-61-49-89-22-27-15-63 2-67 32h-17c-31 0-52 24-52 51h-14c-28 0-47 21-47 45 0 27 23 44 53 44h323Z" fill={paint('cloud')} />
          <path d="M1246 176h37c0 24 17 41 43 41h172m-319 38h250" stroke="#fff" stroke-opacity=".7" stroke-width="3" stroke-linecap="round" />
        </g></g>
      </svg>
      <svg class="sky-horizon" viewBox="0 480 1440 250" preserveAspectRatio="none" fill="none" focusable="false">
        <path d="M-60 637 60 612 122 618 212 586 305 612 380 603 450 632 553 618 659 643 751 630 837 638 945 604 1030 622 1115 593 1202 609 1309 582 1490 621V730H-60Z" fill="#a6dde3" opacity=".42" />
        <path d="M-60 657c190-35 295-12 453-8s250-16 408-2 282-21 387-16 220 10 312-8v107H-60Z" fill="#c0e9e8" />
        <path d="M0 480h1440v250H0Z" fill={paint('mist')} />
        <path d="M0 655c265-15 425-9 720-2s498-14 720-7" stroke="#f7fffb" stroke-width="2" opacity=".7" />
      </svg>
      <svg class="sky-cloud-bottom-left" viewBox="-110 480 590 270" fill="none" focusable="false">
        <g class="scene-front"><g class="cloud-drift cloud-drift--slow">
          <path d="M-90 745V575h48c8-37 38-57 71-49 20-46 76-49 103-10 41-10 75 19 73 57h35c33 0 54 23 54 51h28c37 0 60 28 60 58h70v63Z" fill={paint('cloud')} />
