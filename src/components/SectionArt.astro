        </g></g>
      </svg>
      <svg class="sky-cloud-bottom-right" viewBox="1080 520 450 250" fill="none" focusable="false">
        <g class="scene-front"><g class="cloud-drift cloud-drift--slow">
          <path d="M1103 746v-65h54c-1-32 23-57 56-57h17c2-40 35-64 73-55 21-46 82-47 108-4h99v181Z" fill={paint('cloud')} />
          <path d="M1185 675h122c23 0 38-14 38-36h148" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".8" />
        </g></g>
      </svg>
    </>
  ) : (
    <>
      <svg class="scene-fill" viewBox="0 0 1440 700" preserveAspectRatio="none" fill="none" focusable="false">
        <defs>
          <linearGradient id={id('water')} x1="720" y1="0" x2="720" y2="700" gradientUnits="userSpaceOnUse">
            <stop stop-color="#53cbd0" />
            <stop offset=".2" stop-color="#178b98" />
            <stop offset=".44" stop-color="#0c626f" />
            <stop offset="1" stop-color="#062f40" />
          </linearGradient>
          <linearGradient id={id('depth')} x1="0" y1="350" x2="1440" y2="350" gradientUnits="userSpaceOnUse">
            <stop stop-color="#073e50" stop-opacity=".48" />
            <stop offset=".58" stop-color="#073e50" stop-opacity=".2" />
            <stop offset="1" stop-color="#073e50" stop-opacity="0" />
          </linearGradient>
          <linearGradient id={id('shaft')} x1="1000" y1="70" x2="1160" y2="590" gradientUnits="userSpaceOnUse">
            <stop stop-color="#bdfff1" stop-opacity=".26" />
            <stop offset=".7" stop-color="#80e8df" stop-opacity=".04" />
            <stop offset="1" stop-color="#80e8df" stop-opacity="0" />
          </linearGradient>
          <radialGradient id={id('glow')} cx="0" cy="0" r="1" gradientTransform="translate(1220 120) rotate(90) scale(470 550)" gradientUnits="userSpaceOnUse">
            <stop stop-color="#73ecdd" stop-opacity=".2" />
            <stop offset="1" stop-color="#73ecdd" stop-opacity="0" />
          </radialGradient>
        </defs>
        <path d="M0 0h1440v700H0Z" fill={paint('water')} />
        <path d="M0 0h1440v700H0Z" fill={paint('glow')} />
        <path d="M0 0h1440v700H0Z" fill={paint('depth')} />
      </svg>
      <svg class="ocean-waves" viewBox="0 0 1440 180" preserveAspectRatio="none" fill="none" focusable="false">
        <g class="scene-back">
          <g class="wave-drift">
            <path d="M-100-40h1640V49c-168-34-280 26-458 9S803 28 654 48 378 68 230 44 21 48-100 61Z" fill="#aff0e9" />
            <path d="M-100 53c180-38 291 17 458 15S601 33 778 58s247 29 407 3 265-5 355 3v38c-148-19-219 8-356 20s-297-27-429-12-250 29-395 7S82 96-100 116Z" fill="#69d2d3" opacity=".8" />
            <path d="M-100 58c180-38 291 17 458 15S601 38 778 63s247 29 407 3 265-5 355 3" stroke="#d3fff3" stroke-opacity=".66" stroke-width="2" />
          </g>
          <g class="wave-drift wave-drift--slow">
            <path d="M-100 114c165-24 268 25 422 12s250-25 392-6 235 24 398 1 288-13 428 4v35c-163-24-273 5-427 10s-268-22-402-8-260 17-394 0S48 143-100 166Z" fill="#37afb9" opacity=".65" />
            <path d="M-100 118c165-24 268 25 422 12s250-25 392-6 235 24 398 1 288-13 428 4" stroke="#9ce9e2" stroke-opacity=".42" stroke-width="2" />
            <path d="M992 89c52 6 79 6 119 0m81-6 92-4M78 91c45-1 82 6 126 7" stroke="#e1fff4" stroke-opacity=".46" stroke-width="3" stroke-linecap="round" />
          </g>
        </g>
      </svg>
      <svg class="ocean-light" viewBox="850 50 700 640" fill="none" focusable="false">
        <g class="scene-back"><g class="light-breathe" fill={paint('shaft')}>
          <path d="m905 76 50 1 194 556-277-13Z" />
          <path d="m1054 89 23-1 265 559-173 5Z" />
          <path d="m1216 80 59-5 257 457-161 81Z" />
          <path d="m1355 77 19-1 149 211-18 213Z" />
        </g></g>
      </svg>
      <svg class="ocean-ridge-right" viewBox="870 430 650 300" fill="none" focusable="false">
        <g class="scene-back" opacity=".36">
          <path d="m903 700 73-132 54 7 60-106 57 40 48-63 76 62 52-25 99 71 68-29v175Z" fill="#0c5662" />
          <path d="m1030 575 60-106 15 135 90-158 25 191 103-154 21 217h-441Z" fill="#0a4353" />
        </g>
      </svg>
      <svg class="ocean-ridge-left" viewBox="-60 540 410 190" fill="none" focusable="false">
        <g class="scene-back" opacity=".36">
          <path d="M-40 700V609l98-44 78 36 84-13 106 112Z" fill="#0a4859" />
        </g>
      </svg>
      <svg class="ocean-particles" viewBox="0 0 1440 700" fill="none" focusable="false">
        <g class="scene-front">
          <g class="light-breathe" fill="#b4f4e9">
            <circle cx="1087" cy="240" r="2" opacity=".42" />
            <circle cx="1250" cy="319" r="3" opacity=".32" />
            <circle cx="1182" cy="448" r="1.5" opacity=".5" />
            <circle cx="1370" cy="391" r="2" opacity=".35" />
            <circle cx="985" cy="495" r="1.5" opacity=".3" />
            <circle cx="1320" cy="205" r="1.5" opacity=".5" />
            <circle cx="1138" cy="360" r="1" opacity=".45" />
            <circle cx="1410" cy="524" r="2" opacity=".4" />
            <circle cx="72" cy="320" r="1.5" opacity=".2" />
            <circle cx="140" cy="459" r="1" opacity=".3" />
            <circle cx="267" cy="583" r="1.5" opacity=".2" />
          </g>
          <g stroke="#9ce9df" stroke-opacity=".24">
            <circle cx="1302" cy="373" r="5" />
            <circle cx="1334" cy="295" r="3" />
            <circle cx="1217" cy="517" r="4" />
          </g>
        </g>
      </svg>
      <svg class="ocean-reef-right" viewBox="1080 450 450 310" fill="none" focusable="false">
        <g class="scene-front">
          <path d="m1108 740 63-83 57 6 64-84 90 24 53-48 75 25v160Z" fill="#083849" />
          <path d="m1228 663 64-84 34 105 56-81 25 137h-299Z" fill="#0a4350" />
          <path d="m1292 579 90 24-56 81Z" fill="#175862" opacity=".6" />
          <path d="M1364 653c-17-59-11-117 11-167-6 62-7 107 7 151 4-70 29-107 61-130-28 41-43 93-47 151Z" fill="#17636a" />
          <path d="M1432 671c-6-42 0-89 23-123m-87 98c-15-31-34-49-56-59" stroke="#327b7d" stroke-opacity=".55" stroke-width="4" stroke-linecap="round" />
        </g>
      </svg>
      <svg class="ocean-reef-left" viewBox="-50 620 290 140" fill="none" focusable="false">
        <g class="scene-front">
          <path d="M-40 742V659l76-21 65 34 58-9 61 79Z" fill="#062f40" />
        </g>
      </svg>
      <svg class="ocean-floor" viewBox="0 675 1440 65" preserveAspectRatio="none" fill="none" focusable="false">
        <path d="M-40 691c217-15 396 23 617 12s398 14 568-3 251-4 365-1v41H-40Z" fill="#052c3c" />
      </svg>
    </>
  )}
</div>

<style>
  .section-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .section-art > svg {
    position: absolute;
    display: block;
    height: auto;
    overflow: visible;
  }

  .section-art > .scene-fill,
  .section-art > .ocean-particles {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sky-sun { top: clamp(-150px, -8vw, -60px); right: clamp(0px, 6vw, 180px); width: clamp(220px, 32vw, 480px); }
  .sky-cloud-distant-left { top: 110px; left: -35px; width: clamp(180px, 25vw, 400px); }
  .sky-cloud-distant-right { top: 160px; right: -45px; width: clamp(160px, 23vw, 370px); }
  .sky-island-left { top: clamp(170px, 14vw, 230px); left: clamp(20px, 6vw, 160px); width: clamp(100px, 15vw, 235px); }
  .sky-island-right { top: 230px; right: clamp(20px, 7vw, 180px); width: clamp(90px, 12vw, 180px); }
  .sky-cloud-left { top: -12px; left: -32px; width: clamp(180px, 28vw, 450px); }
  .sky-cloud-right { top: 35px; right: -45px; width: clamp(160px, 24vw, 380px); }
  .section-art > .sky-horizon { bottom: 0; width: 100%; height: 180px; }
  .sky-cloud-bottom-left { bottom: -15px; left: -20px; width: clamp(200px, 30vw, 540px); }
  .sky-cloud-bottom-right { bottom: -15px; right: -20px; width: clamp(160px, 25vw, 430px); }

  .section-art > .ocean-waves { top: 0; width: 100%; height: clamp(100px, 12vw, 160px); }
  .ocean-light { top: 35px; right: 0; width: clamp(240px, 48vw, 760px); }
  .ocean-ridge-right { bottom: -10px; right: -20px; width: clamp(220px, 45vw, 640px); }
  .ocean-ridge-left { bottom: -10px; left: -10px; width: clamp(140px, 24vw, 360px); }
  .ocean-reef-right { bottom: -10px; right: 0; width: clamp(190px, 32vw, 460px); }
  .ocean-reef-left { bottom: -10px; left: -10px; width: clamp(100px, 20vw, 300px); }
  .section-art > .ocean-floor { bottom: 0; width: 100%; height: 45px; }

  .scene-back {
    transform: translate(calc(var(--scene-x, 0px) * .25), calc(var(--scene-y, 0px) * .25));
  }

  .scene-front {
    transform: translate(calc(var(--scene-x, 0px) * .55), calc(var(--scene-y, 0px) * .55));
  }

  .cloud-drift { animation: cloud-drift 24s ease-in-out infinite alternate; }
  .cloud-drift--slow { animation-duration: 32s; animation-delay: -11s; }
  .cloud-drift--reverse { animation-direction: alternate-reverse; animation-delay: -8s; }
  .wave-drift { animation: wave-drift 18s ease-in-out infinite alternate; }
  .wave-drift--slow { animation-duration: 25s; animation-direction: alternate-reverse; animation-delay: -9s; }
  .light-breathe { animation: light-breathe 16s ease-in-out infinite alternate; }

  @keyframes cloud-drift {
    from { transform: translate(-7px, 2px); }
    to { transform: translate(7px, -4px); }
  }

  @keyframes wave-drift {
    from { transform: translate(-12px, 0); }
    to { transform: translate(12px, 3px); }
  }

  @keyframes light-breathe {
    from { opacity: .65; }
    to { opacity: 1; }
  }

  @media (max-width: 760px) {
    .sky-sun { top: -70px; right: 0; width: 220px; }
    .sky-cloud-left { top: -25px; width: 180px; }
    .sky-cloud-right { top: 12px; width: 160px; }
    .sky-cloud-distant-left { top: 65px; width: 160px; }
    .sky-cloud-distant-right { top: 65px; width: 145px; }
    .sky-island-left { top: 76px; left: 16px; width: clamp(80px, 13vw, 100px); }
    .sky-island-right { top: 92px; right: 18px; width: clamp(68px, 11vw, 84px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-back, .scene-front { transform: none; }
    .cloud-drift, .wave-drift, .light-breathe { animation: none; }
  }
</style>
