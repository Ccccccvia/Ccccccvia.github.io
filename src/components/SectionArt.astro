---
interface Props { kind: 'sky' | 'ocean'; }
const { kind } = Astro.props;
const prefix = `${kind}-scene`;
const id = (name: string) => `${prefix}-${name}`;
const paint = (name: string) => `url(#${id(name)})`;
---
<div class:list={['section-art', `section-art--${kind}`]} aria-hidden="true">
  {kind === 'sky' ? (
    <>
      <svg class="scene-fill" viewBox="0 0 1440 700" preserveAspectRatio="none" fill="none" focusable="false">
        <defs>
          <linearGradient id={id('sky')} x1="720" y1="0" x2="720" y2="700" gradientUnits="userSpaceOnUse">
            <stop stop-color="#85dced" />
            <stop offset=".55" stop-color="#c4f1f5" />
            <stop offset="1" stop-color="#effbf5" />
          </linearGradient>
          <radialGradient id={id('sun')} cx="0" cy="0" r="1" gradientTransform="translate(1120 106) scale(250)" gradientUnits="userSpaceOnUse">
            <stop stop-color="#fff8d8" stop-opacity=".95" />
            <stop offset=".28" stop-color="#fff9e5" stop-opacity=".7" />
            <stop offset="1" stop-color="#fffbe9" stop-opacity="0" />
          </radialGradient>
          <linearGradient id={id('cloud')} x1="0" y1="0" x2="0" y2="1">
            <stop stop-color="#fffefa" />
            <stop offset=".62" stop-color="#f5ffff" />
            <stop offset="1" stop-color="#c5e9ed" />
          </linearGradient>
          <linearGradient id={id('cloud-shadow')} x1="0" y1="0" x2="0" y2="1">
            <stop stop-color="#b8e6ec" />
            <stop offset="1" stop-color="#91d3df" stop-opacity=".4" />
          </linearGradient>
          <linearGradient id={id('mist')} x1="720" y1="480" x2="720" y2="700" gradientUnits="userSpaceOnUse">
            <stop stop-color="#e6ffff" stop-opacity="0" />
            <stop offset="1" stop-color="#eafff8" stop-opacity=".95" />
          </linearGradient>
        </defs>
        <path fill={paint('sky')} d="M0 0h1440v700H0z" />
      </svg>
      <svg class="sky-sun" viewBox="850 -170 540 540" fill="none" focusable="false">
        <circle cx="1120" cy="106" r="250" fill={paint('sun')} />
        <circle cx="1120" cy="106" r="44" fill="#fff9dd" opacity=".85" />
        <circle cx="1120" cy="106" r="61" stroke="#fffceb" stroke-opacity=".38" />
      </svg>
      <svg class="sky-cloud-distant-left" viewBox="-115 85 440 200" fill="none" focusable="false">
        <g class="scene-back"><g class="cloud-drift cloud-drift--slow" opacity=".65">
          <path d="M-90 267h352c26 0 40-16 40-31s-13-29-31-29h-19c-5-27-26-42-53-40-8-36-39-55-70-43-18-32-59-37-84-11-28-9-52 5-57 32h-78Z" fill="#eafcff" />
        </g></g>
      </svg>
      <svg class="sky-cloud-distant-right" viewBox="1140 170 410 205" fill="none" focusable="false">
        <g class="scene-back"><g class="cloud-drift cloud-drift--slow" opacity=".65">
          <path d="M1190 362h322v-110h-54c-12-28-38-39-64-26-9-39-56-51-84-22-29-9-54 9-57 35h-23c-31 0-48 24-40 45h-24c-35 0-43 48 24 48Z" fill="#e4faff" />
        </g></g>
      </svg>
      <svg class="sky-island-left" viewBox="55 275 255 190" fill="none" focusable="false">
        <g class="scene-back" opacity=".78">
          <ellipse cx="183" cy="438" rx="113" ry="13" fill="#94d7df" opacity=".25" />
          <path d="m88 368 92-25 99 26-95 33Z" fill="#effdf5" />
          <path d="m88 368 96 34 95-33-28 41-63 24-61-27Z" fill="#a2d9dc" />
          <path d="m184 402 95-33-28 41-63 24Z" fill="#78bccb" />
          <path d="m127 365 54-18 58 17-55 20Z" fill="#c1e8e6" />
          <path d="M139 321v43l44 15v-44Z" fill="#f8fff8" />
          <path d="m183 335 44-14v43l-44 15Z" fill="#b9dee0" />
          <path d="m128 321 55-30 55 30-55 19Z" fill="#fafff7" />
          <path d="m128 321 55 19 55-19v7l-55 19-55-19Z" fill="#9ccbd2" />
          <path d="M149 337v26m13-22v27m35-22v22m14-27v22" stroke="#81b9c6" stroke-width="5" />
          <path d="m147 382 37 13 40-14m-67 11 27 10 30-11" stroke="#f1fff8" stroke-width="3" />
          <path d="M109 355v-24m-7 10 7-14 7 14Z" stroke="#8abfc4" stroke-width="3" fill="#a7d9cd" stroke-linejoin="round" />
        </g>
      </svg>
      <svg class="sky-island-right" viewBox="1200 375 180 140" fill="none" focusable="false">
