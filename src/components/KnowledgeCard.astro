---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'knowledge'>; linked?: boolean; }
const { entry, linked = true } = Astro.props;
const { locale, key, title, subtitle, summary, cardId, collection, cardArt, facts } = entry.data;
const Tag = linked ? 'a' : 'div';
---
<Tag class:list={['knowledge-card', { 'knowledge-card-link': linked }]} href={linked ? `/${locale}/knowledge/${key}/` : undefined}>
  <div class="card-rim">
    <div class="card-title"><span>{title}</span><span class="card-sigil" aria-hidden="true">◇</span></div>
    <div class="card-art"><img src={cardArt} alt="" width="800" height="570" /></div>
    <div class="card-type"><span>{collection}</span><span lang="en">CONCEPT</span></div>
    <div class="card-rules">
      <p class="card-subtitle">{subtitle}</p>
      <div class="card-equations">{facts.map((fact) => <span>{fact.label} <b>{fact.value}</b></span>)}</div>
      <p class="card-summary">{summary}</p>
    </div>
    <div class="card-bottom"><span>{cardId} <span aria-hidden="true">·</span> {locale.toUpperCase()}</span><span lang="en">KNOWLEDGEOS</span><span aria-hidden="true">✧</span></div>
  </div>
</Tag>
