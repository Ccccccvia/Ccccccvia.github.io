---
import { getKnowledgeEntries } from '../../knowledge-content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionArt from '../../components/SectionArt.astro';
import FeaturedDeck from '../../components/FeaturedDeck.astro';
import LibraryActions from '../../components/LibraryActions.astro';
import { locales, pagePath, type Locale } from '../../i18n/ui';
import { featuredCardLimit } from '../../knowledge';
import '../../styles/library.css';
import '../../styles/horizon.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const entries = await getKnowledgeEntries(locale);
const description = zh ? '天空收藏理论，大海孕育实践。从一张知识卡，出发探索原理与创造。' : 'A sky of ideas. An ocean of practice. Explore the principles, then discover what they can become.';
---
<BaseLayout locale={locale} page="home" description={description} theme="horizon">
  <section class="sky-world world-panel" id="sky" aria-labelledby="home-title">
    <SectionArt kind="sky" />
    <div class="world-content">
      <div class="world-coordinate"><span>01 / {zh ? '云上 · 理论知识库' : 'ABOVE / THE KNOWLEDGE LIBRARY'}</span><a href="#ocean">{zh ? '向海下探索' : 'Discover below'} <span aria-hidden="true">↓</span></a></div>
      <header class="world-intro">
        <p class="world-eyebrow" lang="en">A SKY OF IDEAS. AN OCEAN OF PRACTICE.</p>
        <h1 id="home-title">{zh ? '向上，探索原理。' : 'Let your curiosity'}<br/><em>{zh ? '向下，创造可能。' : 'find its horizon.'}</em></h1>
        <p>{description}</p>
        <LibraryActions locale={locale} />
      </header>
      <section class="home-deck" aria-labelledby="home-cards-title">
        <div class="featured-heading"><h2 id="home-cards-title">{zh ? '拾起一个概念' : 'Pick up an idea'}</h2><a href={pagePath(locale, 'knowledge')}>{zh ? '进入知识库' : 'Enter the library'} <span aria-hidden="true">↗</span></a></div>
        <FeaturedDeck entries={entries} />
        <div class="world-meta"><span>{zh ? `精选 ${Math.min(featuredCardLimit, entries.length)} 张 / 共 ${entries.length} 张知识卡` : `${Math.min(featuredCardLimit, entries.length)} featured / ${entries.length} knowledge cards`}</span><span class="hover-hint">{zh ? '悬停拾起 · 点击阅读' : 'HOVER TO LIFT · CLICK TO EXPLORE'}</span><span class="touch-hint">{zh ? '左右滑动 · 点击阅读' : 'SWIPE TO BROWSE · TAP TO EXPLORE'}</span></div>
      </section>
    </div>
  </section>
  <section class="ocean-world world-panel" id="ocean" aria-labelledby="ocean-title">
    <SectionArt kind="ocean" />
    <div class="world-content ocean-content">
      <div class="world-coordinate"><span>02 / {zh ? '海下 · 实作画廊' : 'BELOW / THE SKILL GALLERY'}</span><span lang="en">FROM KNOWING TO MAKING</span></div>
      <div class="ocean-copy"><p class="world-eyebrow">{zh ? '让理解，在实践中生长。' : 'PUT YOUR UNDERSTANDING IN MOTION.'}</p><h2 id="ocean-title">{zh ? '潜入实践。' : 'Dive into making.'}</h2><p>{zh ? '代码、实验与作品，让抽象的知识有具体的落点。这里是未来实作的港口，目前还没有发布作品。' : 'Code, experiments and projects give abstract ideas a place in the world. This harbor is ready; no projects have been published yet.'}</p><a class="gallery-link" href={pagePath(locale, 'projects')}>{zh ? '进入实作画廊' : 'Explore the gallery'}<span aria-hidden="true">↗</span></a></div>
      <a class="surface-link" href="#sky">{zh ? '回到云上' : 'Back to the sky'} <span aria-hidden="true">↑</span></a>
    </div>
  </section>
</BaseLayout>
<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  document.querySelectorAll<HTMLElement>('.world-panel').forEach((panel) => {
    panel.addEventListener('pointermove', (event) => {
      if (motion.matches || !finePointer.matches) return;
      const bounds = panel.getBoundingClientRect();
      panel.style.setProperty('--scene-x', `${((event.clientX - bounds.left) / bounds.width - 0.5) * 24}px`);
      panel.style.setProperty('--scene-y', `${((event.clientY - bounds.top) / bounds.height - 0.5) * 14}px`);
    });
    panel.addEventListener('pointerleave', () => {
      panel.style.setProperty('--scene-x', '0px');
      panel.style.setProperty('--scene-y', '0px');
    });
  });
</script>
