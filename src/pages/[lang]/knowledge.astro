---
import { getKnowledgeEntries } from '../../knowledge-content';
import { knowledgeCatalogPath } from '../../knowledge-paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedDeck from '../../components/FeaturedDeck.astro';
import LibraryActions from '../../components/LibraryActions.astro';
import { locales, type Locale } from '../../i18n/ui';
import { featuredCardLimit } from '../../knowledge';
import '../../styles/library.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const entries = await getKnowledgeEntries(locale);
const description = zh ? '收集一个概念，理解一种原理。每一张卡，都是通往完整知识的入口。' : 'Collect a concept. Understand a principle. Every card opens a deeper explanation.';
---
<BaseLayout locale={locale} page="knowledge" description={description} theme="library">
  <header class="library-intro">
    <div class="atlas-emblem" aria-hidden="true"><span>✧</span></div>
    <p class="small-label" lang="en">THE KNOWLEDGE ATLAS</p>
    <h1>{zh ? '让知识，成为你的卡组。' : 'A collection of understanding.'}</h1>
    <p class="library-lead">{description}</p>
    <form class="library-search" role="search" action={knowledgeCatalogPath(locale)}>
      <label for="card-search" class="sr-only">{zh ? '搜索全部知识卡' : 'Search all knowledge cards'}</label>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5"/></svg>
      <input id="card-search" name="q" type="search" placeholder={zh ? '搜索标题、概念或标签…' : 'Search titles, concepts or tags…'} />
      <button type="submit" class="clear-search">{zh ? '搜索' : 'Search'}</button>
    </form>
    <LibraryActions locale={locale} />
  </header>
  <section class="featured-section" aria-labelledby="featured-heading">
    <div class="featured-heading"><h2 id="featured-heading">{zh ? '从一张卡开始探索' : 'Begin with one idea'}</h2><span>{zh ? `精选 ${Math.min(featuredCardLimit, entries.length)} / 共 ${entries.length} 张` : `${Math.min(featuredCardLimit, entries.length)} featured / ${entries.length} cards`}</span></div>
    <FeaturedDeck entries={entries} />
    <p class="deck-hint">{zh ? '悬停，拾起一个概念。点击，读懂它的来龙去脉。' : 'Hover to lift a card. Open it to explore the idea.'}</p>
  </section>
</BaseLayout>
